#cloud-config
# OpenSearch for the Discovery pilot. The index is derived data on this disk; it can be rebuilt with
# `python -m app.opensearch.bootstrap` run inside the API container app.
package_update: true
packages:
  - docker.io
write_files:
  - path: /etc/sysctl.d/99-opensearch.conf
    content: |
      vm.max_map_count=262144
runcmd:
  - sysctl --system
  - systemctl enable --now docker
  - mkdir -p /var/lib/opensearch-data
  - chown 1000:1000 /var/lib/opensearch-data
  - >-
    docker run -d --name opensearch --restart unless-stopped
    -p ${private_ip}:9200:9200
    -e discovery.type=single-node
    -e OPENSEARCH_JAVA_OPTS="-Xms1g -Xmx1g"
    -e OPENSEARCH_INITIAL_ADMIN_PASSWORD='${admin_password}'
    --ulimit nofile=65536:65536
    -v /var/lib/opensearch-data:/usr/share/opensearch/data
    opensearchproject/opensearch:2.15.0
