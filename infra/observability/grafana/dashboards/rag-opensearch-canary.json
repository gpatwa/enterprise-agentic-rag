    {
      "type": "text",
      "title": "What this shows",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Gates for the OpenSearch chat-retrieval canary (`docs/RAG_OPENSEARCH_CANARY_PLAN.md`). Values are the **recommended, unmeasured defaults**. The stat row covers the dashboard time range, so set it to the stage window. Decide a stage only with the sample-size boxes green. Cross-tenant results have zero tolerance. Nothing here rolls back automatically: set `OPENSEARCH_ROLLBACK=true`."
      }
    },
    {
      "type": "stat",
      "title": "Served OpenSearch calls (min 200)",
      "description": "Minimum sample before a canary stage decision",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(rag_retrieval_requests_total{backend=\"opensearch\",role=\"served\"}[$__range]))",
          "legendFormat": "Served OpenSearch calls (min 200)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 200
              }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      }
    },
