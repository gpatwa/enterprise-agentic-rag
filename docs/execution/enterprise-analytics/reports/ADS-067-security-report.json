  "findings": [
    {
      "id": "F-01",
      "title": "Grouping by an unbucketed timestamp returned one row per order (row-level access through an aggregate)",
      "severity": "high",
      "status": "resolved",
      "resolution": "the compiler refuses a temporal dimension without a time granularity, and refuses grouping by a metric's grain key",
      "evidence_cases": [
        "IN01"
      ],
      "evidence_tests": [
        "test_the_compiler_refuses_row_level_groupings"
      ]
    },
    {
      "id": "F-02",
      "title": "Run IDs were a plain hash of tenant, user, purpose, and a client-chosen key, so a colleague could compute and read another person's run",
      "severity": "high",
      "status": "mitigated",
      "resolution": "`GovernedAnalyzeService(run_id_key=...)` makes the ID an HMAC. The key is a deployment requirement; the reference stack and tests leave it off, which GAP01 documents",
      "residual": "a deployment that omits the key keeps the derivable ID; with F-05 resolved a derived ID no longer lets a colleague read the run, and production refuses to start without run_id_key",
      "evidence_cases": [
        "EX07",
        "GAP01"
      ],
      "evidence_tests": [
        "test_a_server_key_makes_run_ids_underivable"
      ]
    },
    {
      "id": "F-03",
      "title": "Small cohorts and exact differencing: aggregates can reveal individual values",
      "severity": "high",
      "pilot_scope_severity": "medium",
      "status": "open_decision",
      "resolution": "an optional minimum cohort (`min_cohort`, default off) suppresses small groups, refuses a whole population below k as a policy refusal, and refuses filters on the entity key",
      "residual": "differencing across two large cohorts remains possible (GAP03); the right k per dataset, and whether personal data may be onboarded without query auditing, is the data owner's and security owner's decision",
      "evidence_cases": [
        "IN02",
        "IN03",
        "IN04",
        "GAP02",
        "GAP03"
      ],
      "evidence_tests": [
        "test_the_minimum_cohort_is_validated_and_suppression_is_a_warning_not_a_failure"
      ]
    },
    {
      "id": "F-04",
      "title": "A query with no matching rows failed as an internal error instead of answering 'no data'",
      "severity": "low",
      "status": "resolved",
      "resolution": "validation accepts an empty result whose control total is empty",
      "evidence_cases": [
        "IN05"
      ],
      "evidence_tests": [
        "test_an_empty_result_with_an_empty_total_is_valid"
      ]
    },
    {
      "id": "F-05",
      "title": "Any caller in the same tenant with the run's purpose and the run ID can read its status and evidence",
      "severity": "medium",
      "status": "resolved",
      "resolution": "M7 security fixes: only the requester reads a run; a member of the analytics-reviewer group can open it (to decide a review) but never receives the requester's rows; any other colleague gets 403 not_run_requester",
      "residual": "a reviewer sees that a run exists and its state",
      "evidence_cases": [
        "EX01",
        "EX02",
        "GAP01"
      ],
      "evidence_tests": [
        "test_the_documented_gaps_stay_true"
      ]
    },
    {
      "id": "F-06",
      "title": "A time range gave host-dependent results: timezone-aware parameters were compared with naive timestamps in the server's local zone (found on a UTC-7 host, where a range that included every order summed all but one)",
      "severity": "medium",
      "status": "resolved",
      "resolution": "both gateways pin the session time zone to UTC, so naive timestamp columns are UTC on every host",
      "evidence_cases": [
        "TZ01",
        "GAP03"
      ],
      "evidence_tests": [
        "test_the_session_time_zone_is_pinned_to_utc"
      ]
    }
  ],
  "unresolved": []
}
