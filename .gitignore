# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# ============================================================
# Environment & Secrets
# ============================================================
.env
.env.local
.env.production
*.tfvars
!*.tfvars.example
!infra/terraform/envs/*.tfvars
!infra/terraform/azure/envs/*.tfvars
# The Discovery access list is names only (no secrets) and is meant to be reviewed in pull requests.
!infra/terraform/azure-discovery-pilot/access.auto.tfvars
# Backend config names the state account; keep it local (see backend.hcl.example)
infra/terraform/azure-discovery-pilot/backend.hcl

# ============================================================
# Terraform
# ============================================================
**/.terraform/
**/tfplan
**/tfplan-*
**/terraform.tfstate
**/terraform.tfstate.backup
**/.terraform.lock.hcl

# ============================================================
# IDE / OS
# ============================================================
.DS_Store
.vscode/
*.code-workspace
.idea/
*.swp
*.swo
*~

# ============================================================
# Claude Code
# ============================================================
.claude/
.claude/worktrees/

# ============================================================
# Frontend (Node / Vite / Playwright)
# ============================================================
node_modules/
*.tsbuildinfo
apps/*/test-results/
apps/*/playwright-report/
apps/*/blob-report/

# ============================================================
# Data (large files — tracked separately or via DVC)
# ============================================================
data/test-docs/*.pdf
data/test-docs/*.docx

# ============================================================
# Docker / Misc
# ============================================================
*.log
.local/
.cache/archify/
artifacts/
docs/diagrams/*.visual-check.*
.pytest_cache/
.coverage
htmlcov/
data/olist/*.csv

# Discovery: local datasets and built subsets are never committed
services/discovery-api/data/
