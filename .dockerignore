# Root .dockerignore — used by Dockerfile.ingestion
# Prevents copying unnecessary files into the ingestion image.

# Version control
.git
.gitignore

# Infrastructure & deployment (not needed in ingestion image)
infra/
deploy/
scripts/
.github/

# API service (has its own Dockerfile)
services/
!services/analytics-api/
!services/analytics-api/**
!services/discovery-api/
!services/discovery-api/**
# The OpenSearch sink (pipelines/ingestion/indexing/opensearch.py) imports app.search.* and app.config from the
# support API so it shares its document schema. Ship only the package, not tests, migrations or the Dockerfile.
!services/api/app/
!services/api/app/**

# Documentation
docs/
*.md

# Python caches
__pycache__
*.pyc
*.pyo
.pytest_cache

# Virtual environments
venv/
.venv/

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
.claude/

# Docker / compose files
docker-compose*.yml
Dockerfile
Dockerfile.*
.dockerignore

# Environment and secrets
.env
.env.*
!.env.example

# Terraform state
*.tfstate
*.tfstate.backup
.terraform/
