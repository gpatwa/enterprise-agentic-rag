server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass http://${DISCOVERY_API_HOST};
        proxy_http_version 1.1;
        # Container Apps routes by Host header, so send the API's own host, not the web app's.
        proxy_set_header Host ${DISCOVERY_API_HOST};
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        proxy_pass http://${DISCOVERY_API_HOST};
        proxy_set_header Host ${DISCOVERY_API_HOST};
    }

    location / {
        try_files $uri /index.html;
    }
}
