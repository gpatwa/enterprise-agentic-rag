ENV=dev
ANALYTICS_DB_URL=postgresql://ragadmin:changeme@localhost:5432/rag_db
# Separate control store for query outcomes and evidence. Do not point this at
# a customer warehouse used by ANALYTICS_DB_URL.
# ANALYTICS_CONTROL_DB_URL=postgresql://ragadmin:changeme@localhost:5432/analytics_control
# ANALYTICS_SEMANTIC_REGISTRY_PATH=./semantic_registry
ANALYTICS_QUERY_TIMEOUT=10
ANALYTICS_MAX_ROWS=1000
ANALYTICS_DEMO_MODE=false

# Context plane. Compose enables bootstrap automatically; local uvicorn can
# leave this disabled when OpenSearch is not running.
ANALYTICS_OPENSEARCH_URL=
ANALYTICS_CONTEXT_INDEX=context-v1
ANALYTICS_DASHBOARDS_URL=
ANALYTICS_CONTEXT_BOOTSTRAP=false

ANALYTICS_LLM_MODEL=gpt-4o-mini
# ANALYTICS_LLM_API_KEY=
# ANALYTICS_LLM_BASE_URL=http://localhost:11434/v1

# Optional in local development; required when configured.
# ANALYTICS_API_KEY=
ANALYTICS_CORS_ORIGINS=http://localhost:5174
